[gd_scene format=3 uid="uid://bqb0puvcaixop"]

[sub_resource type="GDScript" id="GDScript_overhead"]
script/source = "extends Node2D
# Simpan sebagai anak dari mob. Atur posisi di atas kepala mob lewat Position node ini.

func set_info(enemy_name: String, level: int = 0) -> void:
	$Box/TopRow/EnemyName.text = enemy_name
	$Box/TopRow/EnemyLevel.text = (\"LV %d\" % level) if level > 0 else \"\"

func set_health(current: float, maximum: float) -> void:
	var bar: ProgressBar = $Box/EnemyBar
	bar.max_value = maximum
	bar.value = current
	visible = current > 0.0
"

