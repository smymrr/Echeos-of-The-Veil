[gd_scene format=3]

[sub_resource type="GDScript" id="GDScript_pct"]
script/source = "extends Control\n# Hanya memperbarui angka persen saat slider digeser (visual saja).\n# Aturan nama: XSlider -> XValue. Programmer boleh mengganti script ini.\n\nfunc _ready() -> void:\n\tfor s in find_children(\"*Slider\", \"HSlider\", true, false):\n\t\tvar lbl := find_child(s.name.replace(\"Slider\", \"Value\"), true, false) as Label\n\t\tif lbl:\n\t\t\tlbl.text = \"%d%%\" % int(s.value)\n\t\t\ts.value_changed.connect(func(v: float): lbl.text = \"%d%%\" % int(v))\n"

[sub_resource type="ButtonGroup" id="ButtonGroup_pixel"]

[node name="OptionsPanel" type="Control"]
layout_mode = 3
anchors_preset = 0
offset_right = 610.0
offset_bottom = 300.0
script = SubResource("GDScript_pct")

[node name="Tabs" type="TabContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
tab_alignment = 1
current_tab = 0

