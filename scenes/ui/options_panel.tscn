[gd_scene format=3 uid="uid://rhpypf3tnu4y"]

[sub_resource type="GDScript" id="GDScript_pct"]
script/source = "extends Control
# Hanya memperbarui angka persen saat slider digeser (visual saja).
# Aturan nama: XSlider -> XValue. Programmer boleh mengganti script ini.

func _ready() -> void:
	for s in find_children(\"*Slider\", \"HSlider\", true, false):
		var lbl := find_child(s.name.replace(\"Slider\", \"Value\"), true, false) as Label
		if lbl:
			lbl.text = \"%d%%\" % int(s.value)
			s.value_changed.connect(func(v: float): lbl.text = \"%d%%\" % int(v))
"

