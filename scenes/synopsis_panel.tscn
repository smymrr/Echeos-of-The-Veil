[gd_scene format=3]

[sub_resource type="GDScript" id="GDScript_chapter"]
script/source = "extends Control\n# Hanya menampilkan isi chapter sesuai tombol yang ditekan (visual saja).\n# Tombol: Chapter1Button, Chapter2Button, ... berpasangan dengan Page1, Page2, ...\n\nfunc _ready() -> void:\n\tvar buttons := find_children(\"Chapter*Button\", \"Button\", true, false)\n\tvar pages := $Row/Pages.get_children()\n\tfor i in buttons.size():\n\t\tbuttons[i].pressed.connect(func(): _show(pages, i))\n\t_show(pages, 0)\n\nfunc _show(pages: Array, index: int) -> void:\n\tfor i in pages.size():\n\t\tpages[i].visible = (i == index)\n"

[sub_resource type="ButtonGroup" id="ButtonGroup_chapter"]

[sub_resource type="StyleBoxFlat" id="ch_n"]
bg_color = Color(0.075, 0.06, 0.17, 1)
border_width_left = 3
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
border_color = Color(0.23, 0.18, 0.44, 1)
content_margin_left = 10
content_margin_top = 6
content_margin_right = 8
content_margin_bottom = 6

[sub_resource type="StyleBoxFlat" id="ch_h"]
bg_color = Color(0.1, 0.08, 0.23, 1)
border_width_left = 3
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
border_color = Color(0.48, 0.35, 0.82, 1)
content_margin_left = 10
content_margin_top = 6
content_margin_right = 8
content_margin_bottom = 6

[sub_resource type="StyleBoxFlat" id="ch_p"]
bg_color = Color(0.12, 0.1, 0.27, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.48, 0.35, 0.82, 1)
content_margin_left = 10
content_margin_top = 6
content_margin_right = 8
content_margin_bottom = 6

[sub_resource type="StyleBoxEmpty" id="empty"]

[sub_resource type="StyleBoxFlat" id="textbox"]
bg_color = Color(0.085, 0.065, 0.19, 1)
border_width_left = 0
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.23, 0.18, 0.44, 1)
content_margin_left = 12
content_margin_top = 10
content_margin_right = 12
content_margin_bottom = 10

[node name="SynopsisPanel" type="Control"]
layout_mode = 3
anchors_preset = 0
offset_right = 424.0
offset_bottom = 300.0
script = SubResource("GDScript_chapter")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="ChapterList" type="VBoxContainer" parent="Row"]
custom_minimum_size = Vector2(122, 0)
theme_override_constants/separation = 6

[node name="ChaptersLabel" type="Label" parent="Row/ChapterList"]
theme_override_colors/font_color = Color(0.5, 0.45, 0.72, 1)
theme_override_font_sizes/font_size = 9
text = "CHAPTERS"

[node name="Chapter1Button" type="Button" parent="Row/ChapterList"]
custom_minimum_size = Vector2(0, 46)
toggle_mode = true
button_group = SubResource("ButtonGroup_chapter")
button_pressed = true
theme_override_styles/normal = SubResource("ch_n")
theme_override_styles/hover = SubResource("ch_h")
theme_override_styles/pressed = SubResource("ch_p")
theme_override_styles/hover_pressed = SubResource("ch_p")
theme_override_styles/focus = SubResource("empty")
theme_override_colors/font_color = Color(0.5, 0.45, 0.72, 1)
theme_override_colors/font_hover_color = Color(0.93, 0.9, 1.0, 1)
theme_override_colors/font_pressed_color = Color(0.78, 0.69, 1.0, 1)
theme_override_colors/font_hover_pressed_color = Color(0.78, 0.69, 1.0, 1)
theme_override_font_sizes/font_size = 11
alignment = 0
text = "CH. I\nBefore the Veil"

