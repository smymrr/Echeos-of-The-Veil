[sub_resource type="Shader" id="ShaderKey"]
code = "shader_type canvas_item;
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	if (distance(c.rgb, vec3(0.3725, 0.2824, 0.2824)) < 0.02) { c.a = 0.0; }
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="MatKey"]
shader = SubResource("ShaderKey")

[sub_resource type="Shader" id="ShaderAir"]
code = "shader_type canvas_item;
uniform int frames = 6;
uniform float fps = 5.0;
uniform float frame_w = 32.0;
void fragment() {
	float f = floor(mod(TIME * fps, float(frames)));
	vec2 uv = UV + vec2(f * frame_w * TEXTURE_PIXEL_SIZE.x, 0.0);
	vec4 c = texture(TEXTURE, uv);
	if (distance(c.rgb, vec3(0.3725, 0.2824, 0.2824)) < 0.02) { c.a = 0.0; }
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="MatAir"]
shader = SubResource("ShaderAir")
shader_parameter/frames = 6
shader_parameter/fps = 5.0
shader_parameter/frame_w = 32.0

