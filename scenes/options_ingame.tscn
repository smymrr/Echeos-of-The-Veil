[gd_scene format=3 uid="uid://b55l2ib55hsg4"]

[sub_resource type="GDScript" id="GDScript_opt"]
script/source = "extends CanvasLayer
# Tab kiri + angka persen slider (visual saja). Aturan nama:
#   tombol: AudioTab / DisplayTab / GameplayTab  <->  halaman: AudioPage / DisplayPage / GameplayPage
#   slider: XSlider  <->  angka: XValue

func _ready() -> void:
	var tabs := find_children(\"*Tab\", \"Button\", true, false)
	var pages := $Root/Panel/Content/Body/Pages.get_children()
	for i in tabs.size():
		tabs[i].pressed.connect(func(): _show_page(pages, i))
	_show_page(pages, 0)
	for s in find_children(\"*Slider\", \"HSlider\", true, false):
		var lbl := find_child(s.name.replace(\"Slider\", \"Value\"), true, false) as Label
		if lbl:
			lbl.text = \"%d%%\" % int(s.value)
			s.value_changed.connect(func(v: float): lbl.text = \"%d%%\" % int(v))


func _show_page(pages: Array, index: int) -> void:
	for i in pages.size():
		pages[i].visible = (i == index)
"

