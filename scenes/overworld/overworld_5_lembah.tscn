[sub_resource type="Shader" id="ShaderKey"]
code = "shader_type canvas_item;
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	if (distance(c.rgb, vec3(0.3725, 0.2824, 0.2824)) < 0.02) { c.a = 0.0; }
	COLOR = c;
}
"

